# Copy to .dev.vars (or run: npm run live:setup -- <AISSTREAM_API_KEY>). Never commit .dev.vars.
JWT_SECRET=change-me-to-a-long-random-string
SEED_PASSWORD=change-me-12345

# Live vessels: aisstream (global AIS, free key from https://aisstream.io) | digitraffic (real Baltic AIS, no key) | simulated
DATA_SOURCE=aisstream
AISSTREAM_API_KEY=
# Coverage: india (India + Red Sea/Gulf/Hormuz + Malacca, default) | indian-ocean | world
AIS_REGION=india
